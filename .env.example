# .env.example
# Server Settings
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Settings (SQLite is default; omit DATABASE_PROVIDER for auto-detection)
# DATABASE_PROVIDER=sqlite
# DB_PATH=./data/secrets.db

# Firestore (requires valid firebase-applet-config.json in project root, gitignored)
# DATABASE_PROVIDER=firestore
