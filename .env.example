# .env.example
# Server Settings
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Configures the 'trust proxy' setting in Express to resolve client IPs correctly.
# Options: 
# - 'false' (if deployed directly without reverse proxy)
# - '1' (default; trusts single reverse proxy like Cloud Run, Nginx, or single-tier Docker setup)
# - '2' (trusts dual proxies, e.g., Cloudflare -> Nginx)
# - 'true' (trusts everything, warning: allows spoofing from direct requests)
# - 'loopback' or list of subnet masks
TRUST_PROXY=1

# Database — self-hosted (default: SQLite, no Firebase needed)
# DB_PATH=./data/secrets.db
# DATABASE_PROVIDER=sqlite

# --- GCP Cloud Run only (Firestore) — skip entirely for Docker / VPS self-host ---
# DATABASE_PROVIDER=firestore
# Option A: single JSON string (ideal for Cloud Run Secret Manager)
# FIREBASE_CONFIG={"apiKey":"your-api-key","authDomain":"your-project.firebaseapp.com","projectId":"your-project-id","firestoreDatabaseId":"(default)"}
# Option B: individual variables
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_APP_ID=
# FIREBASE_FIRESTORE_DATABASE_ID=(default)

